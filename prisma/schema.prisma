generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model edges {
  edge_id                      String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspace_id                 String     @db.Uuid
  source_id                    String     @db.Uuid
  target_id                    String     @db.Uuid
  source_handle                String?    @db.VarChar(250)
  target_handle                String?    @db.VarChar(250)
  version                      Int        @default(1)
  created_at                   DateTime   @default(now()) @db.Timestamptz(6)
  updated_at                   DateTime   @default(now()) @db.Timestamptz(6)
  deleted_at                   DateTime?  @db.Timestamptz(6)
  nodes_edges_source_idTonodes nodes      @relation("edges_source_idTonodes", fields: [source_id], references: [node_id], onDelete: Cascade, onUpdate: NoAction)
  nodes_edges_target_idTonodes nodes      @relation("edges_target_idTonodes", fields: [target_id], references: [node_id], onDelete: Cascade, onUpdate: NoAction)
  workspaces                   workspaces @relation(fields: [workspace_id], references: [workspace_id], onDelete: Cascade, onUpdate: NoAction)

  @@index([source_id], map: "idx_edges_source")
  @@index([target_id], map: "idx_edges_target")
  @@index([workspace_id], map: "idx_edges_workspace")
  @@index([workspace_id, updated_at], map: "idx_edges_workspace_updated")
}

model nodes {
  node_id                      String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title                        String?        @db.VarChar(500)
  content                      Json?
  version                      Int            @default(1)
  node_type                    node_type_enum @default(DATA)
  position_x                   Float?
  position_y                   Float?
  created_at                   DateTime       @default(now()) @db.Timestamptz(6)
  updated_at                   DateTime       @default(now()) @db.Timestamptz(6)
  deleted_at                   DateTime?      @db.Timestamptz(6)
  workspace_id                 String         @db.Uuid
  yjs_state                    Bytes?
  depth                        Int?           @default(0)
  edges_edges_source_idTonodes edges[]        @relation("edges_source_idTonodes")
  edges_edges_target_idTonodes edges[]        @relation("edges_target_idTonodes")
  workspaces                   workspaces     @relation(fields: [workspace_id], references: [workspace_id], onDelete: Cascade, onUpdate: NoAction)

  @@index([workspace_id], map: "idx_nodes_workspace")
  @@index([workspace_id, updated_at], map: "idx_nodes_workspace_updated")
}

model users {
  user_id          String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email            String             @unique @db.VarChar(255)
  username         String             @db.VarChar(100)
  password         String             @db.VarChar(255)
  created_at       DateTime           @default(now()) @db.Timestamptz(6)
  updated_at       DateTime           @default(now()) @db.Timestamptz(6)
  deleted_at       DateTime?          @db.Timestamptz(6)
  users_workspaces users_workspaces[]
}

model users_workspaces {
  user_id      String              @db.Uuid
  workspace_id String              @db.Uuid
  role         workspace_role_enum @default(EDITOR)
  joined_at    DateTime            @default(now()) @db.Timestamptz(6)
  users        users               @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)
  workspaces   workspaces          @relation(fields: [workspace_id], references: [workspace_id], onDelete: Cascade, onUpdate: NoAction)

  @@id([user_id, workspace_id])
}

model workspaces {
  workspace_id     String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title            String             @default("Untitled") @db.VarChar(255)
  created_at       DateTime           @default(now()) @db.Timestamptz(6)
  updated_at       DateTime           @default(now()) @db.Timestamptz(6)
  deleted_at       DateTime?          @db.Timestamptz(6)
  edges            edges[]
  nodes            nodes[]
  users_workspaces users_workspaces[]
}

enum node_type_enum {
  PROJECT
  DATA
  RESOURCE
  ARCHIVE
}

enum workspace_role_enum {
  OWNER
  VIEWER
  EDITOR
}
